{
  "name": "aktobe-bazar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:shaders": "node scripts/check-shaders.mjs",
    "check:types": "tsc --noEmit",
    "check:engine": "node scripts/check-engine.mjs",
    "check:apk": "python3 integrations/android/tools/check_apk.py integrations/android/BazarFX.apk",
    "check:shaders:android": "node scripts/check-shaders-android.mjs",
    "check:neural": "python3 scripts/check_sr_weights.py",
    "train:neural": "python3 scripts/train_sr.py",
    "check:hlsl": "python3 scripts/check_unity_shaders.py",
    "export:unity": "python3 scripts/export_unity_weights.py && python3 scripts/make_unitypackage.py",
    "check:enhance": "python3 scripts/check_enhance.py",
    "train:enhance": "python3 scripts/train_enhance.py"
  },
  "dependencies": {
    "autoprefixer": "^10.6.1",
    "lucide-react": "^0.468.0",
    "next": "15.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "typescript": "^5.6.2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.0.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "@shaderfrog/glsl-parser": "^5.1.0"
  }
}
